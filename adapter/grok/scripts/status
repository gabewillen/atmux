#!/usr/bin/env bash
set -euo pipefail
state_dir="${ATMUX_HOME:-$HOME/.atmux}/adapters/grok"
state_file="$state_dir/state.env"
mkdir -p "$state_dir"
[[ -f "$state_file" ]] || printf 'MODEL=%s\nREASONING_LEVEL=%s\n' 'grok-build' 'medium' > "$state_file"
# shellcheck disable=SC1090
source "$state_file"

xml_escape() {
  local s="${1:-}"
  s="${s//&/&amp;}"
  s="${s//</&lt;}"
  s="${s//>/&gt;}"
  s="${s//\"/&quot;}"
  s="${s//\'/&apos;}"
  printf '%s\n' "$s"
}

resolve_target() {
  if [[ -n "${ATMUX_TARGET_PANE:-}" ]]; then
    printf '%s\n' "$ATMUX_TARGET_PANE"
    return
  fi
  if [[ -n "${ATMUX_TMUX_PANE:-}" ]]; then
    printf '%s\n' "$ATMUX_TMUX_PANE"
    return
  fi
  if [[ -n "${TMUX_PANE:-}" ]]; then
    printf '%s\n' "$TMUX_PANE"
    return
  fi
  if [[ -n "${TMUX:-}" ]]; then
    tmux display-message -p '#{pane_id}' 2>/dev/null || true
    return
  fi
  if [[ -n "${ATMUX_SESSION_NAME:-}" ]]; then
    tmux list-panes -t "$ATMUX_SESSION_NAME" -F '#{pane_id}' 2>/dev/null | head -n 1
    return
  fi
  if [[ -n "${ATMUX_REPO:-}" && -n "${ATMUX_AGENT_NAME:-}" ]]; then
    sess="atmux-${ATMUX_REPO}-${ATMUX_AGENT_NAME}"
    tmux list-panes -t "$sess" -F '#{pane_id}' 2>/dev/null | head -n 1
    return
  fi
}

parse_model_and_reasoning() {
  local snapshot="$1"
  local line parsed_model parsed_reasoning

  # Look for --model on the command line in captured history
  line="$(printf '%s\n' "$snapshot" | awk '/--model[[:space:]]/ { l=$0 } END { print l }')"
  if [[ -n "$line" ]]; then
    parsed_model="$(printf '%s\n' "$line" | sed -nE 's/.*--model[[:space:]]+([^[:space:]]+).*/\1/p')"
    if [[ -n "$parsed_model" ]] && [[ "$parsed_model" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
      MODEL="$parsed_model"
    fi
  fi

  # Look for --effort on the command line in captured history
  line="$(printf '%s\n' "$snapshot" | awk '/--effort[[:space:]]/ { l=$0 } END { print l }')"
  if [[ -n "$line" ]]; then
    parsed_reasoning="$(printf '%s\n' "$line" | sed -nE 's/.*--effort[[:space:]]+([^[:space:]]+).*/\1/p')"
    case "$parsed_reasoning" in
      low|medium|high) REASONING_LEVEL="$parsed_reasoning" ;;
      xhigh|xh) REASONING_LEVEL="extra-high" ;;
    esac
  fi

  # Look for model: or Model: in output
  line="$(printf '%s\n' "$snapshot" | awk '/[Mm]odel:/ { l=$0 } END { print l }')"
  if [[ -n "$line" ]]; then
    parsed_model="$(printf '%s\n' "$line" | sed -nE 's/.*[Mm]odel:[[:space:]]*([^[:space:]]+).*/\1/p')"
    if [[ -n "$parsed_model" ]] && [[ "$parsed_model" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
      MODEL="$parsed_model"
    fi
  fi
}

prompt_cursor_is_right_of_start() {
  local line="${1:-}"
  local cursor_x="${2:-}"
  local prompt_col=""
  local before_prompt=""

  [[ "$cursor_x" =~ ^[0-9]+$ ]] || return 1

  [[ "$line" == *"❯"* ]] || return 1
  before_prompt="${line%%❯*}"
  prompt_col=${#before_prompt}

  (( cursor_x > prompt_col ))
}

infer_state() {
  local snapshot="$1"
  local prompt_line="${2:-}"
  local cursor_x="${3:-}"

  if printf '%s\n' "$snapshot" | grep -Eqi 'usage.?limit|rate.?limit|quota.*(exceeded|reached)|429|insufficient.?credits|api.?key.*(invalid|missing)'; then
    printf '%s\n' 'usage-limit'
    return
  fi

  if printf '%s\n' "$snapshot" | grep -Eqi 'error|failed|exception|traceback'; then
    printf '%s\n' 'errored'
    return
  fi

  if prompt_cursor_is_right_of_start "$prompt_line" "$cursor_x"; then
    printf '%s\n' 'idle'
    return
  fi

  if printf '%s\n' "$snapshot" | grep -Eqi 'thinking|running|executing|searching|connecting|tool|using |generating|working|delegat|verif'; then
    printf '%s\n' 'busy'
    return
  fi

  if [[ -n "$snapshot" ]]; then
    printf '%s\n' 'idle'
    return
  fi

  case "${ATMUX_STATE:-idle}" in
    idle|busy|errored|usage-limit) printf '%s\n' "${ATMUX_STATE:-idle}" ;;
    *) printf '%s\n' 'errored' ;;
  esac
}

owner="agent"

snapshot=""
target="$(resolve_target)"
prompt_line=""
cursor_x=""
if [[ -n "$target" ]]; then
  snapshot="$(tmux capture-pane -p -t "$target" -S -400 2>/dev/null | tr -d '\r' || true)"
  cursor_x="$(tmux display-message -t "$target" -p '#{cursor_x}' 2>/dev/null || true)"
  cursor_y="$(tmux display-message -t "$target" -p '#{cursor_y}' 2>/dev/null || true)"
  if [[ "$cursor_y" =~ ^[0-9]+$ ]]; then
    prompt_line="$(tmux capture-pane -p -t "$target" -S 0 2>/dev/null | sed -n "$((cursor_y + 1))p" | tr -d '\r' || true)"
  fi
  parse_model_and_reasoning "$snapshot" || true
fi

state="$(infer_state "$snapshot" "$prompt_line" "$cursor_x")"
printf 'MODEL=%s\nREASONING_LEVEL=%s\n' "$MODEL" "$REASONING_LEVEL" > "$state_file"

printf '<status adapter="%s" owner="%s" state="%s" model="%s" reasoning_level="%s" control_file="AGENTS.md" />\n' \
  "grok" "$(xml_escape "$owner")" "$(xml_escape "$state")" "$(xml_escape "$MODEL")" "$(xml_escape "$REASONING_LEVEL")"

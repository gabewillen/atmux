#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/../../../tests/lib/isolate-tmux.sh"

TESTS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ADAPTER_DIR="$(cd -- "$TESTS_DIR/.." && pwd)"
REPO_ROOT="$(cd -- "$ADAPTER_DIR/../.." && pwd)"
ATMUX_BIN="$REPO_ROOT/bin/atmux"

wait_for_text() {
  local target="$1"
  local needle="$2"
  local timeout="${3:-45}"
  local deadline now snap compact normalized_needle
  normalized_needle="$(printf '%s' "$needle" | tr -d '[:space:]')"
  deadline=$(( $(date +%s) + timeout ))
  while true; do
    snap="$(tmux capture-pane -p -t "$target" -S -1200 2>/dev/null | tr -d '\r' || true)"
    compact="$(printf '%s' "$snap" | tr -d '[:space:]')"
    if printf '%s' "$compact" | grep -Fq "$normalized_needle"; then
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      return 1
    fi
    sleep 0.5
  done
}

atmux_home="$(mktemp -d "${TMPDIR:-/tmp}/atmux-codex-create-task.XXXXXX")"
session_name=""

cleanup() {
  [[ -z "$session_name" ]] || tmux kill-session -t "$session_name" >/dev/null 2>&1 || true
  rm -rf "$atmux_home"
}
trap cleanup EXIT

mkdir -p "$atmux_home/src"
ln -s "$REPO_ROOT" "$atmux_home/src/atmux"

agent_name="codexcreate${RANDOM}"
title="create-task-codex-live-${RANDOM}"

create_out="$(
  ATMUX_ALLOW_OUTSIDE_TMUX=1 \
  ATMUX_HOME="$atmux_home" \
  ATMUX_SOURCE_ROOT="$REPO_ROOT" \
  ATMUX_REPO="live-create-task" \
    "$ATMUX_BIN" agent create "$agent_name" \
      --role worker \
      --intelligence 20 \
      --adapter codex \
      --shared-worktree \
      --task \
      --description "$title" \
      --todo "acknowledge startup task delivery"
)"
session_name="$(printf '%s\n' "$create_out" | awk 'NF { last=$0 } END { print last }')"
[[ -n "$session_name" ]] || { echo "agent create did not print a session" >&2; exit 1; }

pane_id="$(tmux list-panes -t "$session_name" -F '#{pane_id}' 2>/dev/null | head -n 1)"
[[ -n "$pane_id" ]] || { echo "unable to resolve pane id" >&2; exit 1; }

issue_dir="$(find "$atmux_home/issues/live-create-task" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n1 || true)"
[[ -n "$issue_dir" ]] || { echo "agent create --task did not create an issue" >&2; exit 1; }
issue_id="$(basename "$issue_dir")"
[[ "$(cat "$issue_dir/assigned_to")" == "$session_name" ]] || {
  echo "task issue was not assigned to created session" >&2
  cat "$issue_dir/assigned_to" >&2
  exit 1
}

if ! wait_for_text "$pane_id" '<notification type="issue"' 60; then
  tmux capture-pane -p -t "$pane_id" -S -260 >&2 || true
  echo "live codex create --task pane did not receive issue notification" >&2
  exit 1
fi

if ! wait_for_text "$pane_id" "hint=\"run \`atmux issue get $issue_id\`\"" 60; then
  tmux capture-pane -p -t "$pane_id" -S -260 >&2 || true
  echo "live codex create --task pane did not receive issue get hint" >&2
  exit 1
fi

echo "PASS 13_create_task_live"

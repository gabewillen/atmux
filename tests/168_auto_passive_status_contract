#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/isolate-tmux.sh"

TESTS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$TESTS_DIR/.." && pwd)"
AUTO_STATUS="$REPO_ROOT/adapter/auto/scripts/status"
tmp_home="$(mktemp -d "${TMPDIR:-/tmp}/atmux-auto-passive.XXXXXX")"

wait_for_text() {
  local target="$1"
  local needle="$2"
  local timeout="${3:-10}"
  local deadline now snap compact
  deadline=$(( $(date +%s) + timeout ))
  while true; do
    snap="$(tmux capture-pane -p -t "$target" -S -120 2>/dev/null || true)"
    compact="$(printf '%s' "$snap" | tr -d '\r\n')"
    if printf '%s' "$compact" | grep -Fq "$needle"; then
      return 0
    fi
    now="$(date +%s)"
    (( now < deadline )) || return 1
    sleep 0.1
  done
}

write_pane_text() {
  local target="$1"
  local text="$2"
  local cmd
  printf -v cmd "printf '%%s\\n' %q; sleep 100000" "$text"
  tmux respawn-pane -k -t "$target" "$cmd"
}

sess="atmux-auto-passive-${RANDOM}"
pane=""

cleanup() {
  tmux kill-session -t "$sess" >/dev/null 2>&1 || true
  rm -rf "$tmp_home"
}
trap cleanup EXIT

tmux new-session -d -s "$sess" -n "$sess" -c "$REPO_ROOT" "/bin/bash" -l
pane="$(tmux list-panes -t "$sess" -F '#{pane_id}' 2>/dev/null | head -n1)"
[[ -n "$pane" ]] || { echo "pane missing" >&2; exit 1; }

run_auto_passive() {
  ATMUX_HOME="$tmp_home" \
    ATMUX_SOURCE_ROOT="$REPO_ROOT" \
    ATMUX_STATUS_PASSIVE=1 \
    ATMUX_TARGET_PANE="$pane" \
    ATMUX_ADAPTER_SELECTED="codex" \
    env -u ATMUX_STATE \
    "$AUTO_STATUS"
}

assert_xml_contract() {
  local phase="$1"
  local xml="$2"
  local expect_state="$3"
  printf '%s\n' "$xml" | grep -Fq 'adapter="auto"' || {
    echo "$phase: expected adapter=\"auto\" in: $xml" >&2
    exit 1
  }
  printf '%s\n' "$xml" | grep -Fq 'selected="codex"' || {
    echo "$phase: expected selected=\"codex\" in: $xml" >&2
    exit 1
  }
  printf '%s\n' "$xml" | grep -Fq "state=\"${expect_state}\"" || {
    echo "$phase: expected state=\"${expect_state}\" in: $xml" >&2
    exit 1
  }
}

write_pane_text "$pane" "disabled while a task is in progress"
wait_for_text "$pane" "disabled while a task is in progress" 5

busy_xml="$(run_auto_passive)"
assert_xml_contract "busy pane" "$busy_xml" "busy"

write_pane_text "$pane" "ready"
wait_for_text "$pane" "ready" 5

idle_xml="$(run_auto_passive)"
assert_xml_contract "idle pane" "$idle_xml" "idle"

echo "ok: passive auto status keeps adapter=auto and derives state from selected adapter"

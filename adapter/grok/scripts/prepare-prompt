#!/usr/bin/env bash
set -euo pipefail

# Writes atmux prompt content to AGENTS.override.md in the worktree root.
# Official Grok Build (xAI) discovers and merges AGENTS.md + AGENTS.override.md
# from git root down to cwd. Using .override gives atmux instructions precedence
# while still loading any project AGENTS.md files deeper in the tree.
# The override file lives only in the agent's private worktree.

content="$(cat)"
[[ -n "$content" ]] || exit 0

worktree="${ATMUX_WORKTREE:-$(pwd)}"
override="$worktree/AGENTS.override.md"

{
  printf '# atmux agent instructions (managed by atmux — edits will be overwritten)\n\n'
  printf '%s\n' "$content"
  printf '\n# Project AGENTS.md / AGENTS.override.md files (if any) are loaded after this.\n'
} > "$override"

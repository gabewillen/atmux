#!/usr/bin/env bash
set -euo pipefail

# Isolate the tmux socket so this test can never touch the developer's
# default tmux server. Idempotent if the runner already isolated.
source "$(dirname "${BASH_SOURCE[0]}")/lib/isolate-tmux.sh"

TESTS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$TESTS_DIR/.." && pwd)"
ATMUX_BIN="$REPO_ROOT/bin/atmux"

repo_name="waid${RANDOM}"
session="atmux-${repo_name}-worker"
out_file="${TMPDIR:-/tmp}/atmux-watch-agent-idle-${RANDOM}.out"

cleanup() {
  if [[ -n "${watch_pid:-}" ]] && kill -0 "$watch_pid" >/dev/null 2>&1; then
    kill "$watch_pid" >/dev/null 2>&1 || true
    wait "$watch_pid" >/dev/null 2>&1 || true
  fi
  tmux kill-session -t "$session" >/dev/null 2>&1 || true
  rm -f "$out_file"
}
trap cleanup EXIT

wait_for_count() {
  local expected="$1" deadline=$(( $(date +%s) + 8 )) count
  while (( $(date +%s) < deadline )); do
    count="$(grep -c 'type="agent-idle"' "$out_file" 2>/dev/null || true)"
    if (( count >= expected )); then
      return 0
    fi
    sleep 0.1
  done
  echo "expected at least $expected idle notifications" >&2
  cat "$out_file" >&2 2>/dev/null || true
  return 1
}

tmux kill-session -t "$session" >/dev/null 2>&1 || true
tmux new-session -d -s "$session" -n "$session" -x 120 -y 30 -c "$REPO_ROOT" "cat"
tmux set-environment -t "$session" ATMUX_REPO "$repo_name"
tmux set-environment -t "$session" ATMUX_AGENT_NAME "worker"
tmux set-environment -t "$session" ATMUX_SESSION_NAME "$session"
pane="$(tmux list-panes -t "$session" -F '#{pane_id}' 2>/dev/null | head -n1)"
[[ -n "$pane" ]] || { echo "pane missing" >&2; exit 1; }

ATMUX_REPO="$repo_name" ATMUX_ALLOW_OUTSIDE_TMUX=1 \
  "$ATMUX_BIN" agent watch "$session" --idle 2 --timeout 0 --interval 1 >"$out_file" &
watch_pid=$!

sleep 1
tmux send-keys -t "$pane" -l "first-output-${RANDOM}"
tmux send-keys -t "$pane" Enter
wait_for_count 1

sleep 3
count="$(grep -c 'type="agent-idle"' "$out_file" 2>/dev/null || true)"
[[ "$count" -eq 1 ]] || {
  echo "expected exactly one idle notification before new pane activity, got $count" >&2
  cat "$out_file" >&2 2>/dev/null || true
  exit 1
}

tmux send-keys -t "$pane" -l "second-output-${RANDOM}"
tmux send-keys -t "$pane" Enter
wait_for_count 2

echo "ok: agent watch sends one idle notification until pane activity resumes"

#!/usr/bin/env bash
set -euo pipefail

ATMUX_HOME="${ATMUX_HOME:-$HOME/.atmux}"
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/(atmux)/notify
source "$HERE/notify"

usage() {
  cat <<'USAGE'
Usage:
  atmux watcher list
  atmux watcher kill <id> [--timeout <seconds>]

Description:
  List or remove background watcher registrations.
  Watchers are created by `atmux pr watch --feed`, `atmux issue watch --feed`,
  `atmux pr watch <id|url>`, `atmux message subscribe --team`, and
  automatic idle subscriptions created by `atmux agent create` and
  `atmux team create`.

  Watcher ids have the form <kind>:<key>:<watcher_name>, e.g.:
    pr:owner_repo_pr_123:atmux-myrepo-worker-_12
    issues:owner_repo_issues:atmux-myrepo-worker-_12
    prs:owner_repo_prs:atmux-myrepo-worker-_12
    team-message:myrepo_platform:atmux-myrepo-observer-_12
    agent-idle:myrepo_agent_worker:atmux-myrepo-leader-_12
    team-idle:myrepo_platform:atmux-myrepo-leader-_12
USAGE
}

list_watchers() {
  local kind dir watchers_dir watcher_file id
  WATCHER_LIST_NOW="$(date +%s)"
  WATCHER_LIST_LIVE_PANES="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null || true)"
  WATCHER_LIST_LIVE_WINDOWS="$(tmux list-windows -a -F '#{window_id}' 2>/dev/null || true)"
  for kind in pr issues prs team-message agent-idle team-idle; do
    dir="$ATMUX_HOME/watch-$kind"
    [[ -d "$dir" ]] || continue
    while IFS= read -r watchers_dir; do
      [[ -d "$watchers_dir" ]] || continue
      local key
      key="$(basename "$(dirname "$watchers_dir")")"
      while IFS= read -r watcher_file; do
        [[ -e "$watcher_file" ]] || continue
        local watcher_name
        watcher_name="$(basename "$watcher_file")"
        # Skip the .exec sidecar files emitted by --exec watchers.
        case "$watcher_name" in *.exec) continue ;; esac
        if watcher_record_is_stale "$kind" "$watcher_file"; then
          atmux_remove_watcher_record "$watcher_file"
          continue
        fi
        id="${kind}:${key}:${watcher_name}"
        printf '%s\n' "$id"
      done < <(find "$watchers_dir" -mindepth 1 -maxdepth 1 \( -type f -o -type d \) 2>/dev/null | sort)
    done < <(find "$dir" -mindepth 2 -maxdepth 2 -type d -name watchers 2>/dev/null | sort)
  done
}

watcher_record_is_stale() {
  atmux_watcher_record_is_stale "$1" "$2" "$WATCHER_LIST_NOW" "$WATCHER_LIST_LIVE_PANES" "$WATCHER_LIST_LIVE_WINDOWS"
}

verb="${1:-}"
shift || true

case "$verb" in
  list)
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
      usage
      exit 0
    fi
    if [[ $# -gt 0 ]]; then
      echo "atmux watcher list: unexpected arguments" >&2
      exit 2
    fi
    list_watchers
    ;;
  kill)
    id="${1:-}"
    case "$id" in
      -h|--help|help) usage; exit 0 ;;
    esac
    if [[ -z "$id" || "${id:0:1}" == "-" ]]; then
      usage >&2
      exit 2
    fi
    shift
    exec "$HERE/(internal)/kill" --watcher "$id" "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "unknown watcher command: $verb" >&2
    usage >&2
    exit 2
    ;;
esac

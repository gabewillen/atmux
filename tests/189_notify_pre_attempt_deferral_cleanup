#!/usr/bin/env bash
set -euo pipefail

# Items that cannot reach delivery because prompt/bootstrap readiness never
# arrives must not stay at queued/attempts=0 indefinitely.
source "$(dirname "${BASH_SOURCE[0]}")/lib/isolate-tmux.sh"

TESTS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$TESTS_DIR/.." && pwd)"
NOTIFY_SCRIPT="$REPO_ROOT/bin/(atmux)/notify"

ATMUX_HOME="$(mktemp -d "${TMPDIR:-/tmp}/atmux-notify-deferral.XXXXXX")"
ATMUX_SOURCE_ROOT="$REPO_ROOT"
ATMUX_NOTIFY_DEFER_MAX_SECONDS=0
ATMUX_NOTIFY_WORKER_IDLE_TIMEOUT_SECONDS=1
ATMUX_NOTIFY_WORKER_WAKE_TIMEOUT_SECONDS=0.1
export ATMUX_HOME ATMUX_SOURCE_ROOT ATMUX_NOTIFY_DEFER_MAX_SECONDS ATMUX_NOTIFY_WORKER_IDLE_TIMEOUT_SECONDS ATMUX_NOTIFY_WORKER_WAKE_TIMEOUT_SECONDS

# shellcheck source=bin/(atmux)/notify
source "$NOTIFY_SCRIPT"

pane="%defer"

cleanup() {
  rm -rf "$ATMUX_HOME"
}
trap cleanup EXIT

pane_exists() {
  [[ "$1" == "$pane" ]]
}

tmux() {
  if [[ "$1" == "display-message" ]]; then
    local fmt="${@: -1}"
    case "$fmt" in
      "#{pane_id}") printf '%s\n' "$pane" ;;
      "#{pane_in_mode} #{pane_mode} #{scroll_position}") printf '0 copy-mode 0\n' ;;
      "#{session_name}") printf 'mock-session\n' ;;
      '#{session_name}'|'#{pane_current_command}') printf 'mock-session\n' ;;
      *) return 1 ;;
    esac
    return 0
  fi
  if [[ "$1" == "set-hook" ]]; then
    return 0
  fi
  command tmux "$@"
}

resolve_prompt_prefix_for_pane() {
  printf 'PROMPT'
}

wait_for_prompt_ready() {
  return 1
}

payload="$(build_notification "test" "sender" "")"
queue_notification_payload "$pane" "$payload" "Enter"
qdir="$(notify_queue_dir "$pane")"

serve_notification_queue "$pane" "$ATMUX_SOURCE_ROOT"

if [[ -d "$qdir/payloads" ]] && find "$qdir/payloads" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | grep -q .; then
  echo "expected deferred pre-attempt item to be failed and removed" >&2
  find "$qdir" -maxdepth 3 -print >&2
  exit 1
fi

echo "ok: pre-attempt notification deferrals fail and drain after max age"

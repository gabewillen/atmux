#!/usr/bin/env bash
set -euo pipefail

# A notification enqueue must not report success if the per-pane worker cannot
# be started; otherwise stale payloads sit at queued/attempts=0 forever.
source "$(dirname "${BASH_SOURCE[0]}")/lib/isolate-tmux.sh"

TESTS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$TESTS_DIR/.." && pwd)"
NOTIFY_SCRIPT="$REPO_ROOT/bin/(atmux)/notify"

ATMUX_HOME="$(mktemp -d "${TMPDIR:-/tmp}/atmux-notify-spawn-fail.XXXXXX")"
ATMUX_SOURCE_ROOT="$REPO_ROOT"
export ATMUX_HOME ATMUX_SOURCE_ROOT

# shellcheck source=bin/(atmux)/notify
source "$NOTIFY_SCRIPT"

pane="%spawnfail"

cleanup() {
  rm -rf "$ATMUX_HOME"
}
trap cleanup EXIT

pane_exists() {
  [[ "$1" == "$pane" ]]
}

tmux() {
  if [[ "$1" == "display-message" ]]; then
    local fmt="${@: -1}"
    case "$fmt" in
      "#{pane_id}") printf '%s\n' "$pane" ;;
      "#{pane_in_mode} #{pane_mode} #{scroll_position}") printf '0 copy-mode 0\n' ;;
      "#{session_name}"|'#{session_name}') printf 'mock-session\n' ;;
      *) return 1 ;;
    esac
    return 0
  fi
  if [[ "$1" == "has-session" ]]; then
    return 1
  fi
  command tmux "$@"
}

payload="$(build_notification "test" "sender" "")"
if send_notification "$pane" "$payload"; then
  echo "expected send_notification to fail when worker spawn fails" >&2
  exit 1
fi

qdir="$(notify_queue_dir "$pane")"
if [[ -d "$qdir/payloads" ]] && find "$qdir/payloads" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | grep -q .; then
  echo "expected worker-spawn failure to clear queued payloads" >&2
  find "$qdir" -maxdepth 3 -print >&2
  exit 1
fi

echo "ok: worker spawn failure clears queued notification payloads"

#!/usr/bin/env bash
set -euo pipefail

codex_cmd="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../codex" && pwd)/cmd"

export ATMUX_CODEX_ADAPTER_NAME="${ATMUX_CODEX_ADAPTER_NAME:-codextra}"
export ATMUX_CODEX_BINARY="${ATMUX_CODEX_BINARY:-codextra}"
export ATMUX_CODEX_STATE_NAME="${ATMUX_CODEX_STATE_NAME:-codextra}"
export ATMUX_CODEX_MANIFEST="${ATMUX_CODEX_MANIFEST:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/manifest}"
export ATMUX_CODEX_STATUS_TITLE="${ATMUX_CODEX_STATUS_TITLE:-Codextra}"
exec "$codex_cmd" "$@"

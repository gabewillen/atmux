#!/usr/bin/env bash
set -euo pipefail

if ! command -v gemini >/dev/null 2>&1; then
  echo "gemini command not found in PATH" >&2
  exit 127
fi

manifest_lib="${ATMUX_SOURCE_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)}/bin/(atmux)/(lib)/manifest"
# shellcheck source=bin/(atmux)/(lib)/manifest
source "$manifest_lib"

set_bootstrap_state() {
  local state="$1"
  local session=""
  if [[ -n "${ATMUX_TMUX:-}${TMUX:-}" ]]; then
    session="$(tmux display-message -p '#S' 2>/dev/null || true)"
  fi
  [[ -n "$session" ]] || return 0
  tmux set-environment -t "$session" ATMUX_BOOTSTRAP_STATE "$state" >/dev/null 2>&1 || true
}

state_dir="${ATMUX_HOME:-$HOME/.atmux}/adapters/gemini"
state_file="$state_dir/state.env"
mkdir -p "$state_dir"
[[ -f "$state_file" ]] || printf 'MODEL=%s\nREASONING_LEVEL=%s\n' 'gemini-3-flash-preview' 'medium' > "$state_file"
# shellcheck disable=SC1090
source "$state_file"

arg_present() {
  local needle="$1"
  shift || true
  local arg
  for arg in "$@"; do
    [[ "$arg" == "$needle" ]] && return 0
  done
  return 1
}

normalize_model() {
  case "${1:-}" in
    gemini-3.1-flash-lite-preview|gemini-3-flash-preview|gemini-3.1-pro-preview) printf '%s\n' "$1" ;;
    *) return 1 ;;
  esac
}

normalize_reasoning() {
  case "${1:-}" in
    low|medium|high) printf '%s\n' "$1" ;;
    *) return 1 ;;
  esac
}

print_json_string_array() {
  local separator=""
  local item
  printf '['
  for item in "$@"; do
    printf '%s"%s"' "$separator" "$item"
    separator=", "
  done
  printf ']'
}

configure_shell_environment_redaction() {
  [[ -z "${GEMINI_CLI_SYSTEM_SETTINGS_PATH:-}" ]] || return 0

  local settings_file="$state_dir/atmux-system-settings.json"
  local -a allowed=()
  local -a blocked=(
    TMUX
    TMUX_PANE
    BASH_ENV
    ENV
    LD_PRELOAD
    LD_LIBRARY_PATH
    DYLD_INSERT_LIBRARIES
    DYLD_LIBRARY_PATH
    PROMPT_COMMAND
  )
  local env_name

  while IFS= read -r env_name; do
    case "$env_name" in
      ATMUX_*|GEMINI_SYSTEM_MD)
        allowed+=("$env_name")
        ;;
    esac
  done < <(compgen -e | sort -u)

  {
    printf '{\n'
    printf '  "tools": {\n'
    printf '    "shell": {\n'
    printf '      "enableInteractiveShell": true\n'
    printf '    }\n'
    printf '  },\n'
    printf '  "security": {\n'
    printf '    "environmentVariableRedaction": {\n'
    printf '      "enabled": true,\n'
    printf '      "allowed": '
    print_json_string_array "${allowed[@]}"
    printf ',\n'
    printf '      "blocked": '
    print_json_string_array "${blocked[@]}"
    printf '\n'
    printf '    }\n'
    printf '  }\n'
    printf '}\n'
  } > "$settings_file"

  export GEMINI_CLI_SYSTEM_SETTINGS_PATH="$settings_file"
}

configure_shell_wrapper() {
  local wrapper_dir="$state_dir/shell-bin"
  local wrapper="$wrapper_dir/bash"
  local wrapper_log="$state_dir/shell-wrapper.log"
  mkdir -p "$wrapper_dir"

  cat > "$wrapper" <<'SH'
#!/bin/bash
set -euo pipefail

safe_env=()
copy_if_set() {
  local key="$1"
  if [[ -v "$key" ]]; then
    safe_env+=("$key=${!key}")
  fi
}

for key in \
  HOME USER LOGNAME SHELL PATH PWD LANG LC_ALL TERM TMPDIR TEMP TMP \
  SSH_AUTH_SOCK XDG_RUNTIME_DIR \
  GEMINI_SYSTEM_MD GEMINI_CLI_SYSTEM_SETTINGS_PATH GEMINI_CLI_NO_RELAUNCH GEMINI_PTY_INFO \
  ATMUX_GEMINI_SHELL_WRAPPER_LOG; do
  copy_if_set "$key"
done

while IFS= read -r key; do
  case "$key" in
    ATMUX_*)
      safe_env+=("$key=${!key}")
      ;;
  esac
done < <(compgen -e | sort -u)

if [[ -n "${ATMUX_GEMINI_SHELL_WRAPPER_LOG:-}" ]]; then
  {
    printf 'pid=%s ppid=%s argc=%s\n' "$$" "$PPID" "$#"
    printf 'argv='
    printf '%q ' "$@"
    printf '\n'
    printf 'PATH=%s\n' "${PATH:-}"
    printf 'SHELL=%s\n' "${SHELL:-}"
    printf 'TMUX=%s\n' "${TMUX:-}"
    printf 'ATMUX_AGENT_NAME=%s\n' "${ATMUX_AGENT_NAME:-}"
    printf '\n'
  } >> "$ATMUX_GEMINI_SHELL_WRAPPER_LOG" 2>/dev/null || true
fi

exec env -i "${safe_env[@]}" /bin/bash "$@"
SH
  chmod +x "$wrapper"
  export PATH="$wrapper_dir:$PATH"
  export SHELL="$wrapper"
  : > "$wrapper_log"
  export ATMUX_GEMINI_SHELL_WRAPPER_LOG="$wrapper_log"
}

if [[ -n "${ATMUX_INTELLIGENCE:-}" && "${ATMUX_INTELLIGENCE}" =~ ^[0-9]+$ ]] \
  && (( ATMUX_INTELLIGENCE >= 0 && ATMUX_INTELLIGENCE <= 100 )); then
  manifest_path="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/manifest"
  profile="$(resolve_profile_from_manifest "$ATMUX_INTELLIGENCE" "$manifest_path" || true)"
  if [[ -n "$profile" ]]; then
    prof_model="${profile%% *}"
    prof_reasoning="${profile#* }"
    MODEL="$(normalize_model "$prof_model" || printf '%s\n' "$MODEL")"
    REASONING_LEVEL="$(normalize_reasoning "$prof_reasoning" || printf '%s\n' "$REASONING_LEVEL")"
  fi
fi

if [[ -n "${ATMUX_GEMINI_MODEL:-}" ]]; then
  MODEL="$(normalize_model "$ATMUX_GEMINI_MODEL" || { echo "invalid ATMUX_GEMINI_MODEL: $ATMUX_GEMINI_MODEL" >&2; exit 2; })"
fi
if [[ -n "${ATMUX_GEMINI_REASONING_LEVEL:-}" ]]; then
  REASONING_LEVEL="$(normalize_reasoning "$ATMUX_GEMINI_REASONING_LEVEL" || { echo "invalid ATMUX_GEMINI_REASONING_LEVEL: $ATMUX_GEMINI_REASONING_LEVEL" >&2; exit 2; })"
fi

# Generic per-field overrides win over intelligence_map and adapter-specific
# legacy envvars.
if [[ -n "${ATMUX_MODEL:-}" ]]; then
  MODEL="$ATMUX_MODEL"
fi
if [[ -n "${ATMUX_REASONING_LEVEL:-}" ]]; then
  REASONING_LEVEL="$ATMUX_REASONING_LEVEL"
fi

printf 'MODEL=%s\nREASONING_LEVEL=%s\n' "$MODEL" "$REASONING_LEVEL" > "$state_file"

args=("$@")
if ! arg_present --model "${args[@]-}"; then
  args=(--model "$MODEL" "${args[@]-}")
fi
if ! arg_present -y "${args[@]-}" \
  && ! arg_present --yolo "${args[@]-}" \
  && ! arg_present --approval-mode "${args[@]-}"; then
  args=(-y "${args[@]-}")
fi
if ! arg_present --skip-trust "${args[@]-}"; then
  args=(--skip-trust "${args[@]-}")
fi

set_bootstrap_state ready
configure_shell_environment_redaction
configure_shell_wrapper
export GEMINI_CLI_NO_RELAUNCH="${GEMINI_CLI_NO_RELAUNCH:-true}"
export GEMINI_PTY_INFO="${GEMINI_PTY_INFO:-child_process}"
echo "starting gemini in $(pwd)"
exec gemini "${args[@]-}"

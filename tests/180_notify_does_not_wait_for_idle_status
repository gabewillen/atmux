#!/usr/bin/env bash
set -euo pipefail

# Isolate the tmux socket so this test can never touch the developer's
# default tmux server. Idempotent if the runner already isolated.
# shellcheck source=tests/lib/isolate-tmux.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/isolate-tmux.sh"

TESTS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$TESTS_DIR/.." && pwd)"
NOTIFY_SCRIPT="$REPO_ROOT/bin/(atmux)/notify"

ATMUX_HOME="$(mktemp -d "${TMPDIR:-/tmp}/atmux-no-idle-wait.XXXXXX")"
ATMUX_SOURCE_ROOT="$REPO_ROOT"
export ATMUX_HOME ATMUX_SOURCE_ROOT
export ATMUX_SEND_SETTLE_SECONDS=0.05
export ATMUX_SEND_PASTE_TO_SUBMIT_WAIT_SECONDS=0.1
export ATMUX_SEND_SUBMIT_WAIT_SECONDS=0.05
export ATMUX_SEND_NO_PROMPT_READY_SECONDS=0.1
export ATMUX_SEND_PASTE_READY_TIMEOUT_SECONDS=2
export ATMUX_SEND_SUBMIT_VERIFY_SECONDS=1

# shellcheck source=bin/(atmux)/notify
source "$NOTIFY_SCRIPT"

session="atmux-no-idle-wait-$$-$RANDOM"
calls_file="$ATMUX_HOME/status-calls"

cleanup() {
  tmux kill-session -t "$session" >/dev/null 2>&1 || true
  rm -rf "$ATMUX_HOME"
}
trap cleanup EXIT

mkdir -p "$ATMUX_HOME/adapters/mockbusy/scripts"
cat > "$ATMUX_HOME/adapters/mockbusy/manifest" <<'MANIFEST'
NAME=mockbusy
VERSION=1
SUBMIT_KEYS_STEER=(Enter)
INPUT_START=">"
MANIFEST
cat > "$ATMUX_HOME/adapters/mockbusy/scripts/status" <<'STATUS'
#!/usr/bin/env bash
printf 'called\n' >> "$ATMUX_HOME/status-calls"
printf '<status adapter="mockbusy" state="busy" />\n'
STATUS
chmod +x "$ATMUX_HOME/adapters/mockbusy/scripts/status"

wait_for_text() {
  local target="$1" needle="$2" timeout="${3:-5}"
  local deadline now snap compact
  deadline=$(( $(date +%s) + timeout ))
  while true; do
    snap="$(tmux capture-pane -p -t "$target" -S -200 2>/dev/null || true)"
    compact="$(printf '%s' "$snap" | tr -d '\r\n')"
    if printf '%s' "$compact" | grep -Fq "$needle"; then
      return 0
    fi
    now="$(date +%s)"
    (( now >= deadline )) && return 1
    sleep 0.05
  done
}

tmux kill-session -t "$session" >/dev/null 2>&1 || true
tmux new-session -d -s "$session" -n "$session" -x 120 -y 30 "cat"
tmux set-environment -t "$session" ATMUX_ADAPTER "mockbusy"

pane="$(tmux list-panes -t "$session" -F '#{pane_id}' 2>/dev/null | head -n1)"
[[ -n "$pane" ]] || { echo "pane missing" >&2; exit 1; }

sleep 0.2
tmux send-keys -t "$pane" -l "> "
sleep 0.2

marker="no-idle-wait-$RANDOM"
payload="$(build_notification "test" "$marker" "")"
send_notification "$pane" "$payload"

if ! wait_for_text "$pane" "$marker" 5; then
  echo "notification did not deliver while adapter status was busy" >&2
  tmux capture-pane -p -t "$pane" -S -80 >&2 || true
  exit 1
fi

if [[ -s "$calls_file" ]]; then
  echo "notification worker should not consult adapter idle status before delivery" >&2
  cat "$calls_file" >&2
  exit 1
fi

echo "ok: notification delivery does not wait for adapter idle status"

#!/usr/bin/env bash

codex_validate_state_name() {
  local name="$1"
  if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || "$name" == *..* ]]; then
    echo "invalid codex adapter state name: $name" >&2
    return 2
  fi
}

codex_resolve_state_name() {
  local default_name="${1:-codex}"
  local name="${ATMUX_CODEX_STATE_NAME:-${ATMUX_CODEX_ADAPTER_NAME:-$default_name}}"
  codex_validate_state_name "$name" || return $?
  printf '%s\n' "$name"
}

#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=tests/lib/isolate-tmux.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/isolate-tmux.sh"

TESTS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$TESTS_DIR/.." && pwd)"
ATMUX_BIN="$REPO_ROOT/bin/atmux"

tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/atmux-async-dispatch.XXXXXX")"
ATMUX_HOME="$tmp_root/.atmux"
ATMUX_SOURCE_ROOT="$REPO_ROOT"
export ATMUX_HOME ATMUX_SOURCE_ROOT

repo="asyncdispatch${RANDOM}"
sender_session="atmux-${repo}-sender"
receiver_session="atmux-${repo}-receiver"

cleanup() {
  tmux kill-session -t "$sender_session" >/dev/null 2>&1 || true
  tmux kill-session -t "$receiver_session" >/dev/null 2>&1 || true
  rm -rf "$tmp_root"
}
trap cleanup EXIT

wait_for_text() {
  local pane="$1"
  local needle="$2"
  local timeout="${3:-20}"
  local deadline snap
  deadline=$(( $(date +%s) + timeout ))
  while true; do
    snap="$(tmux capture-pane -p -t "$pane" -S -20000 2>/dev/null || true)"
    if [[ "$snap" == *"$needle"* ]]; then
      return 0
    fi
    if (( $(date +%s) >= deadline )); then
      echo "missing text in $pane: $needle" >&2
      tmux capture-pane -p -t "$pane" -S -200 >&2 || true
      return 1
    fi
    sleep 0.1
  done
}

tmux new-session -d -s "$sender_session" -n "$sender_session" -x 140 -y 40 "cat"
tmux new-session -d -s "$receiver_session" -n "$receiver_session" -x 140 -y 40 "cat"
tmux set-environment -t "$sender_session" ATMUX_SESSION_NAME "$sender_session"
tmux set-environment -t "$receiver_session" ATMUX_SESSION_NAME "$receiver_session"

sender_pane="$(tmux list-panes -t "$sender_session" -F '#{pane_id}' | head -n1)"
receiver_pane="$(tmux list-panes -t "$receiver_session" -F '#{pane_id}' | head -n1)"
[[ -n "$sender_pane" && -n "$receiver_pane" ]] || { echo "missing test panes" >&2; exit 1; }

tmux send-keys -t "$sender_pane" -l "❯ "
tmux send-keys -t "$sender_pane" Enter
tmux send-keys -t "$receiver_pane" -l "❯ "
tmux send-keys -t "$receiver_pane" Enter

start_ms="$(date +%s000)"
async_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
    "$ATMUX_BIN" send --to "$receiver_session" "async-dispatch-${RANDOM}"
)"
elapsed_ms=$(( $(date +%s000) - start_ms ))

printf '%s\n' "$async_out" | grep -Fq '<async command="send '
if (( elapsed_ms > ${ATMUX_ASYNC_DISPATCH_RETURN_BUDGET_MS:-1500} )); then
  echo "async send returned too slowly: ${elapsed_ms}ms" >&2
  exit 1
fi

wait_for_text "$receiver_pane" 'hint="run `atmux message read ' 20
wait_for_text "$sender_pane" 'type="command"' 20
wait_for_text "$sender_pane" 'command="atmux send --to ' 20
wait_for_text "$sender_pane" 'exit_code="0"' 20

issue_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
    "$ATMUX_BIN" issue create --title "async issue ${RANDOM}"
)"
printf '%s\n' "$issue_out" | grep -Fq '<async command="issue create '
wait_for_text "$sender_pane" 'command="atmux issue create ' 20

list_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
    "$ATMUX_BIN" message list
)"
if printf '%s\n' "$list_out" | grep -Fq '<async '; then
  echo "message list should not dispatch asynchronously by default" >&2
  exit 1
fi

env_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
  TMUX_PANE="$receiver_pane" \
  ATMUX_ASYNC_SECRET_SHOULD_NOT_LEAK="secret-${RANDOM}" \
    "$ATMUX_BIN" env
)"
if printf '%s\n' "$env_out" | grep -Fq '<async '; then
  echo "env should not dispatch asynchronously by default" >&2
  exit 1
fi

env_out="$(
  ATMUX_ASYNC_COMMANDS=all \
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
  TMUX_PANE="$receiver_pane" \
  ATMUX_ASYNC_SECRET_SHOULD_NOT_LEAK="secret-${RANDOM}" \
    "$ATMUX_BIN" env
)"
printf '%s\n' "$env_out" | grep -Fq '<async command="env"'
wait_for_text "$sender_pane" 'command="atmux env"' 20

env_command_file=""
deadline=$(( $(date +%s) + 20 ))
while [[ -z "$env_command_file" ]]; do
  env_command_file="$(grep -R -l '^atmux env$' "$ATMUX_HOME/async/$repo" 2>/dev/null | head -n1 || true)"
  [[ -n "$env_command_file" ]] && break
  if (( $(date +%s) >= deadline )); then
    echo "async env command state was not written for explicit all mode" >&2
    exit 1
  fi
  sleep 0.1
done
env_state_dir="$(dirname "$env_command_file")"
if grep -Fq 'ATMUX_ASYNC_SECRET_SHOULD_NOT_LEAK' "$env_state_dir/stdout"; then
  echo "async runner leaked non-allowlisted ATMUX environment into child command" >&2
  exit 1
fi
grep -Fq "ATMUX_TMUX_PANE=$sender_pane" "$env_state_dir/stdout"
if grep -Fxq "TMUX_PANE=$receiver_pane" "$env_state_dir/stdout"; then
  echo "async runner forwarded caller TMUX_PANE into child command" >&2
  exit 1
fi

team_name="asyncdispatchteam${RANDOM}"
mkdir -p "$ATMUX_HOME/teams/$repo/$team_name"
printf '%s\n' "$team_name" > "$ATMUX_HOME/teams/$repo/$team_name/name"
subscribe_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
    "$ATMUX_BIN" message subscribe --team "$team_name"
)"
if printf '%s\n' "$subscribe_out" | grep -Fq '<async '; then
  echo "message subscribe should not dispatch asynchronously" >&2
  exit 1
fi
printf '%s\n' "$subscribe_out" | grep -Fq '<subscription type="team-message"'

doctor_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
    "$ATMUX_BIN" doctor --project --project-root "$tmp_root" --dry-run
)"
if printf '%s\n' "$doctor_out" | grep -Fq '<async '; then
  echo "doctor command should not dispatch asynchronously" >&2
  exit 1
fi
printf '%s\n' "$doctor_out" | grep -Fq 'doctor:'

role_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
    "$ATMUX_BIN" role list
)"
if printf '%s\n' "$role_out" | grep -Fq '<async '; then
  echo "role command should not dispatch asynchronously" >&2
  exit 1
fi

mkdir -p "$ATMUX_HOME/adapters/mock"
cat > "$ATMUX_HOME/adapters/mock/cmd" <<'ADAPTER'
#!/usr/bin/env bash
printf 'adapter-%s\n' "${1:-}"
ADAPTER
chmod +x "$ATMUX_HOME/adapters/mock/cmd"
adapter_start_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
    "$ATMUX_BIN" adapter mock start
)"
if printf '%s\n' "$adapter_start_out" | grep -Fq '<async '; then
  echo "adapter start command should not dispatch asynchronously" >&2
  exit 1
fi
printf '%s\n' "$adapter_start_out" | grep -Fq 'adapter-start'

schedule_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
    "$ATMUX_BIN" schedule --once 5s --notification "async-schedule-${RANDOM}"
)"
if printf '%s\n' "$schedule_out" | grep -Fq '<async '; then
  echo "schedule command should not dispatch asynchronously" >&2
  exit 1
fi
printf '%s\n' "$schedule_out" | grep -Fq '<schedule'

fail_out="$(
  ATMUX_REPO="$repo" \
  ATMUX_AGENT_NAME="sender" \
  ATMUX_SESSION_NAME="$sender_session" \
  ATMUX_TMUX_PANE="$sender_pane" \
    "$ATMUX_BIN" send --to "missing-${RANDOM}" "async-fail-${RANDOM}"
)"
printf '%s\n' "$fail_out" | grep -Fq '<async command="send '
wait_for_text "$sender_pane" 'status="failed"' 20
wait_for_text "$sender_pane" 'exit_code="1"' 20
wait_for_text "$sender_pane" 'stderr:' 20
sender_snap="$(tmux capture-pane -p -t "$sender_pane" -S -20000)"
if [[ "$sender_snap" == *'\nstderr:\n'* ]]; then
  echo "async failure summary rendered literal newline escape sequences" >&2
  exit 1
fi

echo "ok: async dispatcher detaches sends and notifies success/failure"

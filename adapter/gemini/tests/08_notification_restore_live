#!/usr/bin/env bash
set -euo pipefail

TESTS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$TESTS_DIR/scripts"
ADAPTER_DIR="$(cd -- "$TESTS_DIR/.." && pwd)"
REPO_ROOT="$(cd -- "$ADAPTER_DIR/../.." && pwd)"
ATMUX_BIN="$REPO_ROOT/bin/atmux"
NOTIFY_SCRIPT="$REPO_ROOT/bin/(atmux)/notify"

# Isolate tmux to a private socket; atmux_tmux_socket() prefers ATMUX_TMUX_SOCKET,
# so we can use temp ATMUX_HOME for notify queues without breaking pane capture/send.
# shellcheck source=tests/lib/isolate-tmux.sh
source "$REPO_ROOT/tests/lib/isolate-tmux.sh"

# Require repo tmux shim first so plain `tmux` in gemini setup respects
# ATMUX_TMUX_SOCKET (system tmux would ignore it and use the default server).
export PATH="$REPO_ROOT/bin:${PATH:-}"

wait_for_text() {
  local target="$1"
  local needle="$2"
  local timeout="${3:-20}"
  local deadline now snap
  deadline=$(( $(date +%s) + timeout ))
  while true; do
    snap="$(tmux capture-pane -p -t "$target" -S -1200 2>/dev/null | tr -d '\r' || true)"
    if printf '%s' "$snap" | grep -Fq "$needle"; then
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      return 1
    fi
    sleep 0.2
  done
}

# Bounded poll: notify saves/restores via extract_prompt_input; it must match
# the typed partial text before injection (legacy plain+cursor path mis-reads
# styled Gemini lines).
wait_for_extract_prompt_input() {
  local pane="$1"
  local expected="$2"
  local prompt_prefix="$3"
  local timeout="${4:-20}"
  local deadline now extracted
  deadline=$(( $(date +%s) + timeout ))
  while true; do
    extracted="$(extract_prompt_input "$pane" "$prompt_prefix" 2>/dev/null || true)"
    if [[ "$extracted" == "$expected" ]]; then
      return 0
    fi
    now="$(date +%s)"
    if (( now >= deadline )); then
      return 1
    fi
    sleep 0.2
  done
}

# After restore, the editable line must not still carry Gemini's empty-state
# placeholder or path chrome alongside our partial text (wrong save/restore
# bounds would concatenate placeholder with typed text).
assert_restored_line_excludes_placeholder() {
  local pane="$1"
  local partial="$2"
  local snap line bad=0
  snap="$(tmux capture-pane -p -t "$pane" -S -1200 2>/dev/null | tr -d '\r' || true)"
  while IFS= read -r line; do
    [[ "$line" == *"$partial"* ]] || continue
    if [[ "$line" == *"Type your message"* || "$line" == *"@path/to/file"* ]]; then
      bad=1
      break
    fi
  done <<< "$snap"
  if (( bad )); then
    printf '%s\n' "$snap" >&2
    echo "restored input line still contains Gemini placeholder or @path chrome" >&2
    return 1
  fi
  return 0
}

atmux_home="$(mktemp -d "${TMPDIR:-/tmp}/atmux-gemini-live.XXXXXX")"
cleanup() {
  [[ -n "${session_name:-}" ]] && "$SCRIPTS_DIR/teardown" --session "$session_name" >/dev/null 2>&1 || true
  rm -rf "$atmux_home"
}
trap cleanup EXIT

start_cmd="ATMUX_HOME='$atmux_home' '$ADAPTER_DIR/scripts/start'"
setup_out="$("$SCRIPTS_DIR/setup" --command "$start_cmd" --wait-text 'Type your message')"
session_name="$(printf '%s\n' "$setup_out" | sed -n 's/^SESSION_NAME=//p' | tail -n 1)"
pane_id="$(printf '%s\n' "$setup_out" | sed -n 's/^PANE_ID=//p' | tail -n 1)"
if [[ -z "$session_name" || -z "$pane_id" ]]; then
  echo "missing setup output (SESSION_NAME or PANE_ID)" >&2
  exit 1
fi

tmux set-environment -t "$session_name" ATMUX_ADAPTER "gemini"
tmux set-environment -t "$session_name" ATMUX_SESSION_NAME "$session_name"

test_tmux_socket="${ATMUX_TMUX_SOCKET:-}"
if [[ -z "$test_tmux_socket" ]]; then
  echo "missing ATMUX_TMUX_SOCKET after isolate/setup (cannot pin tmux for notify + pane)" >&2
  exit 1
fi

export ATMUX_HOME="$atmux_home" ATMUX_SOURCE_ROOT="$REPO_ROOT" ATMUX_ALLOW_OUTSIDE_TMUX=1 \
  ATMUX_TMUX_SOCKET="$test_tmux_socket"
# shellcheck source=bin/(atmux)/notify
source "$NOTIFY_SCRIPT"

prompt_prefix="$(resolve_input_prompt_for_adapter gemini "$REPO_ROOT")"
[[ -n "$prompt_prefix" ]] || {
  echo "missing INPUT_START for gemini manifest" >&2
  exit 1
}

partial_text="partial-gemini-live-${RANDOM}"
notification_xml="<notification type=\"test\" from=\"notify-gemini-live-${RANDOM}\" />"

tmux send-keys -t "$pane_id" -l "$partial_text"

if ! wait_for_extract_prompt_input "$pane_id" "$partial_text" "$prompt_prefix" 25; then
  tmux capture-pane -p -e -t "$pane_id" -S -120 >&2 || true
  echo "live gemini extract_prompt_input did not match typed partial text before notify" >&2
  exit 1
fi

ATMUX_HOME="$atmux_home" ATMUX_SOURCE_ROOT="$REPO_ROOT" ATMUX_ALLOW_OUTSIDE_TMUX=1 \
  ATMUX_TMUX_SOCKET="$test_tmux_socket" \
  "$ATMUX_BIN" notify --pane "$pane_id" --xml "$notification_xml"

if ! wait_for_text "$pane_id" "$notification_xml" 20; then
  tmux capture-pane -p -t "$pane_id" -S -220 >&2 || true
  echo "live gemini pane did not display notification xml" >&2
  exit 1
fi

if ! wait_for_text "$pane_id" "$partial_text" 20; then
  tmux capture-pane -p -t "$pane_id" -S -220 >&2 || true
  echo "live gemini pane did not restore partial input" >&2
  exit 1
fi

if ! assert_restored_line_excludes_placeholder "$pane_id" "$partial_text"; then
  exit 1
fi

echo "PASS 08_notification_restore_live"

#!/usr/bin/env bash
set -euo pipefail

# Isolate the tmux socket so this test can never touch the developer's
# default tmux server. Idempotent if the runner already isolated.
source "$(dirname "${BASH_SOURCE[0]}")/lib/isolate-tmux.sh"

TESTS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$TESTS_DIR/.." && pwd)"
ATMUX_BIN="$REPO_ROOT/bin/atmux"

tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/atmux-start-adapters.XXXXXX")"
tmp_home="$tmp_root/home"
atmux_home="$tmp_home/.atmux"
# Use the actual repo dir name (normalized the same way atmux does) —
# hardcoding "amux_sh" only worked when the repo was checked out as
# amux.sh/. Linux CI clones to /home/runner/work/atmux/atmux/, where
# the basename is "atmux".
repo_name_raw="$(basename "$REPO_ROOT")"
repo_name="$(printf '%s' "$repo_name_raw" | sed -E 's/[^A-Za-z0-9_-]+/_/g; s/_+/_/g; s/^_+//; s/_+$//')"
agent="allowlist-${RANDOM}"
bad_agent="disallowed-${RANDOM}"
inherited_bad_agent="inherited-disallowed-${RANDOM}"
inherited_bad_list_agent="inherited-list-${RANDOM}"
inherited_set_agent="inherited-set-${RANDOM}"
role_pref_agent="role-pref-${RANDOM}"
team_pref="team-pref-${RANDOM}"
team_pref_member="${team_pref}-member"
session="atmux-${repo_name}-${agent}"
bad_session="atmux-${repo_name}-${bad_agent}"
inherited_bad_session="atmux-${repo_name}-${inherited_bad_agent}"
inherited_bad_list_session="atmux-${repo_name}-${inherited_bad_list_agent}"
inherited_set_session="atmux-${repo_name}-${inherited_set_agent}"
role_pref_session="atmux-${repo_name}-${role_pref_agent}"
team_pref_session="atmux-${repo_name}-${team_pref_member}"

cleanup() {
  tmux kill-session -t "$session" >/dev/null 2>&1 || true
  tmux kill-session -t "$bad_session" >/dev/null 2>&1 || true
  tmux kill-session -t "$inherited_bad_session" >/dev/null 2>&1 || true
  tmux kill-session -t "$inherited_bad_list_session" >/dev/null 2>&1 || true
  tmux kill-session -t "$inherited_set_session" >/dev/null 2>&1 || true
  tmux kill-session -t "$role_pref_session" >/dev/null 2>&1 || true
  "$ATMUX_BIN" team kill "$team_pref" >/dev/null 2>&1 || true
  tmux kill-session -t "$team_pref_session" >/dev/null 2>&1 || true
  rm -rf "$tmp_root"
}
trap cleanup EXIT

make_adapter() {
  local name="$1"
  local dir="$atmux_home/adapters/$name"
  mkdir -p "$dir"
  cat > "$dir/cmd" <<ADAPTER
#!/usr/bin/env bash
set -euo pipefail
case "\${1:-}" in
  control-file)
    ;;
  start)
    printf '%s\n' "$name" > "\$ATMUX_HOME/selected-adapter"
    sleep 30
    ;;
  status)
    printf '<adapter-state state="idle" />\n'
    ;;
  *)
    ;;
esac
ADAPTER
  chmod +x "$dir/cmd"
}

mkdir -p "$tmp_home" "$atmux_home/adapters"
make_adapter alpha
make_adapter beta
role_dir="$atmux_home/roles/agents/role-pref"
mkdir -p "$role_dir"
cat > "$role_dir/role.md" <<'EOF'
# Role preference probe
EOF
cat > "$role_dir/manifest" <<'EOF'
KIND=agent
INTELLIGENCE=50
ADAPTERS=(alpha)
EOF
team_role_dir="$atmux_home/roles/teams/team-pref"
mkdir -p "$team_role_dir"
cat > "$team_role_dir/role.md" <<'EOF'
# Team preference probe
EOF
cat > "$team_role_dir/manifest" <<EOF
KIND=team
MEMBERS=(
  "$team_pref_member --role role-pref --intelligence 50 --shared-worktree"
)
EOF

tmux kill-session -t "$session" >/dev/null 2>&1 || true
tmux kill-session -t "$bad_session" >/dev/null 2>&1 || true
tmux kill-session -t "$inherited_bad_session" >/dev/null 2>&1 || true
tmux kill-session -t "$inherited_bad_list_session" >/dev/null 2>&1 || true
tmux kill-session -t "$inherited_set_session" >/dev/null 2>&1 || true
tmux kill-session -t "$role_pref_session" >/dev/null 2>&1 || true
tmux kill-session -t "$team_pref_session" >/dev/null 2>&1 || true

(
  cd "$REPO_ROOT"
  HOME="$tmp_home" \
    ATMUX_HOME="$atmux_home" \
    ATMUX_SOURCE_ROOT="$REPO_ROOT" \
    ATMUX_ALLOW_OUTSIDE_TMUX=1 \
    "$ATMUX_BIN" agent create --name "$agent" --role worker --intelligence 50 --shared-worktree --adapters beta >/dev/null
)

deadline=$(( $(date +%s) + 10 ))
while [[ ! -f "$atmux_home/selected-adapter" ]]; do
  if (( $(date +%s) >= deadline )); then
    echo "timed out waiting for allowlisted adapter start" >&2
    exit 1
  fi
  sleep 0.1
done

selected="$(tr -d '\r\n' < "$atmux_home/selected-adapter")"
[[ "$selected" == "beta" ]] || { echo "expected beta adapter, got ${selected:-missing}" >&2; exit 1; }

# Poll up to 5s for ATMUX_ADAPTER_SELECTED on the session env. start_session
# sets it to the requested value (here "auto") synchronously, but run_adapter
# updates it to the actually-selected adapter ("beta") asynchronously after
# the pane shell picks up and runs `_run-adapter`. On slower hosts (Linux CI)
# the pane shell can take a moment to register, so polling avoids a race.
session_selected=""
deadline=$(( $(date +%s) + 5 ))
while true; do
  session_selected="$(tmux show-environment -t "$session" ATMUX_ADAPTER_SELECTED 2>/dev/null | sed -n 's/^ATMUX_ADAPTER_SELECTED=//p' || true)"
  [[ "$session_selected" == "beta" ]] && break
  (( $(date +%s) >= deadline )) && break
  sleep 0.1
done
if [[ "$session_selected" != "beta" ]]; then
  echo "expected session selected adapter beta, got ${session_selected:-missing}" >&2
  tmux show-environment -t "$session" 2>&1 >&2 || true
  exit 1
fi

set +e
(
  cd "$REPO_ROOT"
  HOME="$tmp_home" \
    ATMUX_HOME="$atmux_home" \
    ATMUX_SOURCE_ROOT="$REPO_ROOT" \
    ATMUX_ALLOW_OUTSIDE_TMUX=1 \
    "$ATMUX_BIN" agent create --name "$bad_agent" --role worker --intelligence 50 --shared-worktree --adapter alpha --adapters beta >/dev/null 2>&1
)
rc=$?
set -e

[[ "$rc" -eq 2 ]] || { echo "expected disallowed explicit adapter to exit 2, got $rc" >&2; exit 1; }
if tmux has-session -t "$bad_session" 2>/dev/null; then
  echo "disallowed adapter should not create a session" >&2
  exit 1
fi

set +e
(
  cd "$REPO_ROOT"
  HOME="$tmp_home" \
    ATMUX_HOME="$atmux_home" \
    ATMUX_SOURCE_ROOT="$REPO_ROOT" \
    ATMUX_ADAPTERS_ALLOWED=beta \
    ATMUX_ALLOW_OUTSIDE_TMUX=1 \
    "$ATMUX_BIN" agent create --name "$inherited_bad_agent" --role worker --intelligence 50 --shared-worktree --adapter alpha >/dev/null 2>&1
)
rc=$?
set -e

[[ "$rc" -eq 2 ]] || { echo "expected inherited disallowed adapter to exit 2, got $rc" >&2; exit 1; }
if tmux has-session -t "$inherited_bad_session" 2>/dev/null; then
  echo "inherited disallowed adapter should not create a session" >&2
  exit 1
fi

set +e
(
  cd "$REPO_ROOT"
  HOME="$tmp_home" \
    ATMUX_HOME="$atmux_home" \
    ATMUX_SOURCE_ROOT="$REPO_ROOT" \
    ATMUX_ADAPTERS_ALLOWED=beta \
    ATMUX_ALLOW_OUTSIDE_TMUX=1 \
    "$ATMUX_BIN" agent create --name "$inherited_bad_list_agent" --role worker --intelligence 50 --shared-worktree --adapters alpha >/dev/null 2>&1
)
rc=$?
set -e

[[ "$rc" -eq 2 ]] || { echo "expected inherited disallowed --adapters to exit 2, got $rc" >&2; exit 1; }
if tmux has-session -t "$inherited_bad_list_session" 2>/dev/null; then
  echo "inherited disallowed --adapters should not create a session" >&2
  exit 1
fi

set +e
(
  cd "$REPO_ROOT"
  HOME="$tmp_home" \
    ATMUX_HOME="$atmux_home" \
    ATMUX_SOURCE_ROOT="$REPO_ROOT" \
    ATMUX_ADAPTERS_ALLOWED=beta \
    ATMUX_ALLOW_OUTSIDE_TMUX=1 \
    "$ATMUX_BIN" agent create --name "$inherited_set_agent" --role worker --intelligence 50 --shared-worktree --set adapter=alpha >/dev/null 2>&1
)
rc=$?
set -e

[[ "$rc" -eq 2 ]] || { echo "expected inherited disallowed --set adapter to exit 2, got $rc" >&2; exit 1; }
if tmux has-session -t "$inherited_set_session" 2>/dev/null; then
  echo "inherited disallowed --set adapter should not create a session" >&2
  exit 1
fi

rm -f "$atmux_home/selected-adapter"
(
  cd "$REPO_ROOT"
  HOME="$tmp_home" \
    ATMUX_HOME="$atmux_home" \
    ATMUX_SOURCE_ROOT="$REPO_ROOT" \
    ATMUX_ADAPTERS_ALLOWED=alpha,beta \
    ATMUX_ALLOW_OUTSIDE_TMUX=1 \
    "$ATMUX_BIN" agent create --name "$role_pref_agent" --role role-pref --intelligence 50 --shared-worktree >/dev/null
)

deadline=$(( $(date +%s) + 10 ))
while [[ ! -f "$atmux_home/selected-adapter" ]]; do
  if (( $(date +%s) >= deadline )); then
    echo "timed out waiting for role-preferred adapter start" >&2
    exit 1
  fi
  sleep 0.1
done

selected="$(tr -d '\r\n' < "$atmux_home/selected-adapter")"
[[ "$selected" == "alpha" ]] || { echo "expected role-preferred alpha adapter, got ${selected:-missing}" >&2; exit 1; }

rm -f "$atmux_home/selected-adapter"
(
  cd "$REPO_ROOT"
  HOME="$tmp_home" \
    ATMUX_HOME="$atmux_home" \
    ATMUX_SOURCE_ROOT="$REPO_ROOT" \
    ATMUX_ADAPTERS_ALLOWED=alpha,beta \
    ATMUX_ALLOW_OUTSIDE_TMUX=1 \
    "$ATMUX_BIN" team create "$team_pref" --role team-pref --shared-worktree >/dev/null
)

deadline=$(( $(date +%s) + 10 ))
while [[ ! -f "$atmux_home/selected-adapter" ]]; do
  if (( $(date +%s) >= deadline )); then
    echo "timed out waiting for team member role-preferred adapter start" >&2
    exit 1
  fi
  sleep 0.1
done

selected="$(tr -d '\r\n' < "$atmux_home/selected-adapter")"
[[ "$selected" == "alpha" ]] || { echo "expected team member role-preferred alpha adapter, got ${selected:-missing}" >&2; exit 1; }

echo "ok: atmux agent create --adapters restricts adapter selection"
